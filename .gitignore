# Ignore everything
/*

!.gitignore
!.gitmodules

# But allow tracked folders/files
!hypr/
!kitty/
!skwd-wall/
!swaync/
!systemd/
systemd/*
!systemd/user/
systemd/user/*
!systemd/user/skwd-daemon.service.d/
!Thunar/
!waybar/
!walker/
!bashrc

# Ignore files produced/tweaked by scripts
/hypr/conf.d/10-monitors-active.conf
/hypr/wallpaper_effects
/kitty/skwd-theme.conf
/hypr/.display-mode

# Generated by matugen via skwd-wall
/waybar/modules/colors.css
/swaync/matugen-colors.css
/walker/themes/skwd/colors.css
