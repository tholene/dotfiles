{
  "layer": "bottom",
  "position": "top",
  "height": 36,
  "margin-top": 12,
  "margin-left": 12,
  "margin-right": 12,
  "spacing": 12,

  "reload_style_on_change": true,

  "modules-left": [ "cpu", "memory", "custom/codexbar", "network#speed"],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": ["mpris", "pulseaudio", "tray","custom/keyboard", "clock", "custom/notifications"],

  "hyprland/workspaces": {
    "format": "{name} {icon}",
    "on-click": "activate",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "5": "",
      "6": "",
      "7": "",
      "urgent": "",
      "active": "",
      "default": ""
    },
    "sort-by-number": true
  },

  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip-format": false
  },

  "pulseaudio": {
    "format": "  {volume}%",
    "format-muted": "  muted"
  },

  "network#speed": {
    "interval": 1,
    "format": "{ifname}",
    "format-wifi": " {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-ethernet": " {bandwidthDownBytes}  {bandwidthUpBytes} ",
    "format-disconnected": "󰌙",
    "tooltip-format": "{ipaddr}",
    "format-linked": "󰈁 {ifname} (No IP)",
    "tooltip-format-ethernet": "󰈀 {ifname}\n{ipaddr}",
    "tooltip-format-disconnected": "󰌙 Disconnected",
    "max-length": 30
  },

  "cpu": { "format": "  {usage}%" },
  "memory": { "format": "󰍛  {used:0.1f}G" },

  "tray": {
    "spacing": 10,
    "icon-size": 20
  },

  "mpris": {
    "format": "{dynamic} {player_icon} ",
    "format-paused": "{status_icon} ",
    "player-icons": {
      "default": "\uf28b",
      "spotify": "",
      "chromium": ""
    },
    "status-icons": {
      "paused": "\uf144"
    },
    "dynamic-order": [
      "title",
      "artist"
    ],
    "on-click": "hyprctl dispatch exec [float] hyprmixer",
    "max-length": 1000,
    "interval": 1
  },

  "custom/keyboard": {
    "exec": "~/.config/waybar/modules/keyboard-layout.sh",
    "interval": 1,
    "tooltip": false
  },

  "custom/notifications": {
    "tooltip": true,
    "format": "{icon} {0}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "custom/codexbar": {
    "exec": "$HOME/.config/waybar/scripts/codexbar.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 30,
    "signal": 8,
    "on-click": "$HOME/.config/waybar/scripts/codexbar-popup.py",
    "on-click-right": "bash -c 'notify-send -a CodexBar -t 8000 \"AI usage\" \"$($HOME/.config/waybar/scripts/codexbar.sh | jq -r .tooltip)\"'",
    "tooltip": true,
    "max-length": 24
  }
}